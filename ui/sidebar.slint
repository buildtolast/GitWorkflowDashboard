import { Theme } from "theme.slint";
import { StatusDot, SearchInput, ActionButton } from "widgets.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";

// Model for a repo in the sidebar
export struct SidebarRepo {
    name: string,
    active-run-count: int,
    selected: bool,
}

// Model for search results
export struct SearchResult {
    full-name: string,
    description: string,
    language: string,
    stars: int,
    is-private: bool,
    selected: bool,
}

export component Sidebar inherits Rectangle {
    in property <[SidebarRepo]> repos: [];
    in property <[SearchResult]> search-results: [];
    in property <bool> searching: false;
    in property <int> sidebar-width: 280;

    callback add-repo(string);
    callback remove-repo(string);
    callback toggle-sidebar-repo(string);
    callback search-repos(string);
    callback toggle-search-result(string);
    callback add-selected-search-results;

    width: sidebar-width * 1px;
    background: Theme.colors.bg-sidebar;
    border-width: 0px;

    Rectangle {
        width: 1px;
        x: parent.width - 1px;
        background: Theme.colors.border;
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ─── Add Repo Section ───
        Rectangle {
            background: Theme.colors.bg-surface;
            height: add-section-layout.preferred-height + 16px;
            border-width: 0px;

            Rectangle {
                height: 1px;
                y: parent.height - 1px;
                background: Theme.colors.border;
            }

            add-section-layout := VerticalLayout {
                padding: 8px;
                spacing: 8px;

                Text {
                    text: "Add Repository";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.colors.text-heading;
                }

                // Search input
                SearchInput {
                    placeholder: "Search GitHub repos...";
                    edited(query) => {
                        root.search-repos(query);
                    }
                }

                // Search results
                if search-results.length > 0 : Rectangle {
                    background: Theme.colors.bg-main;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.colors.border;
                    height: Math.min(search-results.length * 40, 200) * 1px;

                    ScrollView {
                        VerticalLayout {
                            spacing: 0px;
                            for result[idx] in search-results : Rectangle {
                                height: 40px;
                                background: result.selected ? Theme.colors.tint-cyan : (result-ta.has-hover ? Theme.colors.bg-hover : transparent);

                                result-ta := TouchArea {
                                    clicked => { root.toggle-search-result(result.full-name); }
                                    mouse-cursor: pointer;
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;

                                    Text {
                                        text: result.selected ? "☑" : "☐";
                                        font-size: 14px;
                                        color: Theme.colors.accent-cyan;
                                        vertical-alignment: center;
                                        width: 20px;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: result.full-name;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.colors.text-primary;
                                            overflow: elide;
                                        }
                                        if result.language != "" : Text {
                                            text: result.language + (result.stars > 0 ? " ★" + result.stars : "");
                                            font-size: 10px;
                                            color: Theme.colors.text-muted;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Add selected button
                if search-results.length > 0 : ActionButton {
                    label: "Add Selected";
                    btn-color: Theme.colors.accent-green;
                    clicked => { root.add-selected-search-results(); }
                }

                // Manual add row
                HorizontalLayout {
                    spacing: 4px;

                    manual-input := LineEdit {
                        placeholder-text: "owner/repo";
                        font-size: 12px;
                        horizontal-stretch: 1;
                        accepted => {
                            if self.text != "" {
                                root.add-repo(self.text);
                                self.text = "";
                            }
                        }
                    }
                    ActionButton {
                        label: "+";
                        min-width: 32px;
                        btn-color: Theme.colors.accent-cyan;
                        clicked => {
                            if manual-input.text != "" {
                                root.add-repo(manual-input.text);
                                manual-input.text = "";
                            }
                        }
                    }
                }
            }
        }

        // ─── Repo List ───
        Text {
            text: "Repositories (" + repos.length + ")";
            font-size: 11px;
            font-weight: 700;
            color: Theme.colors.text-muted;
            horizontal-alignment: left;
            height: 28px;
            vertical-alignment: center;
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 0px;

                for repo[idx] in repos : Rectangle {
                    height: 36px;
                    background: repo-ta.has-hover ? Theme.colors.bg-hover : transparent;
                    border-width: 0px;

                    // Left accent border for selected repos
                    if repo.selected : Rectangle {
                        width: 3px;
                        height: parent.height;
                        x: 0px;
                        background: Theme.colors.accent-cyan;
                    }

                    repo-ta := TouchArea {
                        clicked => { root.toggle-sidebar-repo(repo.name); }
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            StatusDot {
                                dot-color: repo.active-run-count > 0 ? Theme.colors.accent-green : Theme.colors.text-muted;
                            }
                            Text {
                                text: repo.name;
                                font-size: 12px;
                                color: repo.selected ? Theme.colors.text-bright : Theme.colors.text-primary;
                                font-weight: repo.selected ? 600 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if repo.active-run-count > 0 : Rectangle {
                                height: 18px;
                                min-width: 18px;
                                border-radius: 9px;
                                background: Theme.colors.accent-yellow;

                                Text {
                                    text: repo.active-run-count;
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: Theme.colors.bg-main;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Remove button
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 4px;
                            background: remove-ta.has-hover ? Theme.colors.tint-red : transparent;

                            remove-ta := TouchArea {
                                clicked => { root.remove-repo(repo.name); }
                                mouse-cursor: pointer;
                            }
                            Text {
                                text: "×";
                                font-size: 14px;
                                color: remove-ta.has-hover ? Theme.colors.accent-red : Theme.colors.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Empty state
                if repos.length == 0 : VerticalLayout {
                    padding: 16px;
                    alignment: center;
                    Text {
                        text: "No repositories added yet.\nSearch or enter owner/repo above.";
                        font-size: 12px;
                        color: Theme.colors.text-muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ─── Build Info ───
        Rectangle {
            height: 28px;
            background: Theme.colors.bg-surface;

            Rectangle {
                height: 1px;
                y: 0px;
                background: Theme.colors.border;
            }

            Text {
                text: "Build: " + Theme.current-theme;
                font-size: 10px;
                color: Theme.colors.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
