import { Theme } from "theme.slint";
import { SearchInput, ActionButton, SectionCard } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

export struct WorkflowModel {
    id: int,
    name: string,
    path: string,
    state: string,
    repo: string,
}

export component WorkflowsTab inherits Rectangle {
    in property <[WorkflowModel]> workflows: [];
    in-out property <string> search-query: "";

    callback search-changed(string);
    callback trigger-workflow(string, int, string);

    background: Theme.colors.bg-main;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Search bar
        SearchInput {
            placeholder: "Search workflows...";
            text: search-query;
            edited(q) => { root.search-changed(q); }
        }

        // Workflow list
        if workflows.length == 0 : Text {
            text: search-query == "" ? "No workflows found. Add repositories to see their workflows." : "No workflows match your search.";
            font-size: 14px;
            color: Theme.colors.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if workflows.length > 0 : ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 6px;

                // Header row
                Rectangle {
                    height: 32px;
                    background: Theme.colors.bg-surface;
                    border-radius: 4px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        Text { text: "Workflow"; font-size: 11px; font-weight: 700; color: Theme.colors.text-muted; horizontal-stretch: 2; vertical-alignment: center; }
                        Text { text: "File"; font-size: 11px; font-weight: 700; color: Theme.colors.text-muted; horizontal-stretch: 2; vertical-alignment: center; }
                        Text { text: "State"; font-size: 11px; font-weight: 700; color: Theme.colors.text-muted; horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: "Repo"; font-size: 11px; font-weight: 700; color: Theme.colors.text-muted; horizontal-stretch: 2; vertical-alignment: center; }
                        Text { text: "Action"; font-size: 11px; font-weight: 700; color: Theme.colors.text-muted; width: 80px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                for wf in workflows : Rectangle {
                    height: 40px;
                    background: wf-ta.has-hover ? Theme.colors.bg-hover : transparent;
                    border-radius: 4px;

                    wf-ta := TouchArea { mouse-cursor: default; }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        Text { text: wf.name; font-size: 13px; color: Theme.colors.text-primary; horizontal-stretch: 2; vertical-alignment: center; overflow: elide; }
                        Text { text: wf.path; font-size: 11px; color: Theme.colors.text-muted; font-family: "monospace"; horizontal-stretch: 2; vertical-alignment: center; overflow: elide; }
                        Text {
                            text: wf.state;
                            font-size: 11px;
                            color: wf.state == "active" ? Theme.colors.accent-green : Theme.colors.text-muted;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text { text: wf.repo; font-size: 12px; color: Theme.colors.accent-cyan; horizontal-stretch: 2; vertical-alignment: center; overflow: elide; }
                        ActionButton {
                            width: 80px;
                            label: "Trigger";
                            btn-color: Theme.colors.accent-purple;
                            clicked => { root.trigger-workflow(wf.repo, wf.id, wf.name); }
                        }
                    }
                }
            }
        }
    }
}
