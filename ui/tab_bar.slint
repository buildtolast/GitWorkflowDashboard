import { Theme } from "theme.slint";

export component TabBar inherits Rectangle {
    in property <int> active-tab: 0;
    in property <int> active-runs-count: 0;
    callback tab-clicked(int);

    height: 40px;
    background: Theme.colors.bg-surface;

    Rectangle {
        height: 1px;
        y: parent.height - 1px;
        background: Theme.colors.border;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 2px;
        alignment: start;

        // Tab 0: Active Runs
        Rectangle {
            height: parent.height;
            min-width: tab0-layout.preferred-width + 16px;
            background: active-tab == 0 ? Theme.colors.bg-hover : (tab0-ta.has-hover ? Theme.colors.bg-hover : transparent);
            border-radius: 4px;

            Rectangle {
                visible: active-tab == 0;
                height: 2px;
                y: parent.height - 2px;
                background: Theme.colors.accent-cyan;
            }

            tab0-ta := TouchArea {
                clicked => { root.tab-clicked(0); }
                mouse-cursor: pointer;
            }
            tab0-layout := HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: center;
                Text {
                    text: "Active Runs";
                    font-size: 12px;
                    font-weight: active-tab == 0 ? 700 : 400;
                    color: active-tab == 0 ? Theme.colors.accent-cyan : Theme.colors.text-primary;
                    vertical-alignment: center;
                }
                if active-runs-count > 0 : Rectangle {
                    height: 18px;
                    min-width: 18px;
                    border-radius: 9px;
                    background: Theme.colors.accent-yellow;
                    Text {
                        text: active-runs-count;
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.colors.bg-main;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Tab 1-5 (reusable pattern)
        for tab-info[idx] in [
            { label: "Workflows", index: 1 },
            { label: "Actions", index: 2 },
            { label: "History", index: 3 },
            { label: "What's Happening", index: 4 },
            { label: "Analytics", index: 5 },
        ] : Rectangle {
            height: parent.height;
            min-width: tab-label.preferred-width + 16px;
            background: active-tab == tab-info.index ? Theme.colors.bg-hover : (tab-ta.has-hover ? Theme.colors.bg-hover : transparent);
            border-radius: 4px;

            Rectangle {
                visible: active-tab == tab-info.index;
                height: 2px;
                y: parent.height - 2px;
                background: Theme.colors.accent-cyan;
            }

            tab-ta := TouchArea {
                clicked => { root.tab-clicked(tab-info.index); }
                mouse-cursor: pointer;
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: center;
                tab-label := Text {
                    text: tab-info.label;
                    font-size: 12px;
                    font-weight: active-tab == tab-info.index ? 700 : 400;
                    color: active-tab == tab-info.index ? Theme.colors.accent-cyan : Theme.colors.text-primary;
                    vertical-alignment: center;
                }
            }
        }
    }
}
