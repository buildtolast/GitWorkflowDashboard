import { Theme } from "theme.slint";

export struct ToastModel {
    id: int,
    message: string,
    toast-type: string,   // "success", "error", "info"
    timestamp: int,
}

export component ToastOverlay inherits Rectangle {
    in property <[ToastModel]> toasts: [];
    callback dismiss-toast(int);

    // Positioned at top-right via parent layout
    background: transparent;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        alignment: start;

        for toast in toasts : Rectangle {
            height: 48px;
            min-width: 280px;
            max-width: 400px;
            border-radius: 6px;
            background: Theme.colors.bg-surface;
            border-width: 1px;
            border-color: toast.toast-type == "success" ? Theme.colors.status-success :
                         toast.toast-type == "error" ? Theme.colors.status-failure :
                         Theme.colors.accent-cyan;

            // Left accent stripe
            Rectangle {
                width: 4px;
                height: parent.height;
                x: 0px;
                border-radius: 3px;
                background: toast.toast-type == "success" ? Theme.colors.status-success :
                           toast.toast-type == "error" ? Theme.colors.status-failure :
                           Theme.colors.accent-cyan;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                alignment: space-between;

                // Icon + message
                HorizontalLayout {
                    spacing: 8px;
                    horizontal-stretch: 1;
                    Text {
                        text: toast.toast-type == "success" ? "✓" :
                             toast.toast-type == "error" ? "✗" : "ℹ";
                        font-size: 14px;
                        color: toast.toast-type == "success" ? Theme.colors.status-success :
                              toast.toast-type == "error" ? Theme.colors.status-failure :
                              Theme.colors.accent-cyan;
                        vertical-alignment: center;
                    }
                    Text {
                        text: toast.message;
                        font-size: 12px;
                        color: Theme.colors.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                // Dismiss button
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: toast-dismiss-ta.has-hover ? Theme.colors.bg-hover : transparent;

                    toast-dismiss-ta := TouchArea {
                        clicked => { root.dismiss-toast(toast.id); }
                        mouse-cursor: pointer;
                    }
                    Text {
                        text: "×";
                        font-size: 14px;
                        color: Theme.colors.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
